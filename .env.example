# ==============================================================================
# MMS Studio Storage — Environment Configuration
# ==============================================================================
# Serverless media storage, image optimization pipeline, and delivery engine.
# Designed for mobile apps, web applications, and media asset management.

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Neon Serverless PostgreSQL or Local PostgreSQL)
# ------------------------------------------------------------------------------
# Production: postgresql://[user]:[password]@[endpoint].neon.tech/neondb?sslmode=require
# Local Dev:  postgresql://sabbirmms@localhost:5432/mms_studio_storage
DATABASE_URL="postgresql://sabbirmms@localhost:5432/mms_studio_storage"

# ------------------------------------------------------------------------------
# 2. NEXTAUTH & GOOGLE OAUTH AUTHENTICATION
# ------------------------------------------------------------------------------
# (Optional) If omitted, the system automatically uses NEXT_PUBLIC_APP_URL
# NEXTAUTH_URL="https://cloud.sabbirmms.com"
# Generate secret with: openssl rand -base64 32
NEXTAUTH_SECRET="mms_cloudvault_secure_auth_secret_key_2026_replace_me"

# Google Cloud Console OAuth 2.0 Client credentials
# https://console.cloud.google.com/apis/credentials
# Authorized redirect URIs (Callback URL):
# - Local:      http://localhost:3000/api/auth/callback/google
# - Production: https://cloud.sabbirmms.com/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Initial Superadmin Email (Bypasses empty allowed emails list on initial setup)
INITIAL_SUPERADMIN_EMAIL="mr.sabbirmms@gmail.com"

# Local Development Admin Passcode (Used for quick local dev login bypass)
DEV_ADMIN_PASSCODE="admin123"

# ------------------------------------------------------------------------------
# 3. OBJECT STORAGE (Cloudflare R2 or AWS S3 Compatible)
# ------------------------------------------------------------------------------
# For Cloudflare R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# Leave blank or "local" in local dev to enable automatic local file fallback (/public/uploads)
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_BUCKET_NAME="mms-studio-storage"
STORAGE_REGION="auto"
# Public CDN URL mapped to bucket (e.g. https://storage.mms-studio.com or https://pub-xxx.r2.dev)
STORAGE_PUBLIC_URL=""

# ------------------------------------------------------------------------------
# 4. SYSTEM CRON & AUTOMATION SECRET
# ------------------------------------------------------------------------------
# Used to authenticate scheduled cron jobs (e.g., auto-cleanup of 30-day trash)
# Header required: Authorization: Bearer <CRON_SECRET>
CRON_SECRET="mms_cron_secret_key_9x8f72a4bc01"

# ------------------------------------------------------------------------------
# 5. OPTIONAL TELEGRAM NOTIFICATIONS (Defaults can also be configured in DB)
# ------------------------------------------------------------------------------
# TELEGRAM_BOT_TOKEN="123456789:ABCDefghIJKLmnOPQRstuvWXYZ"
# TELEGRAM_CHAT_ID="-1001234567890"

# ------------------------------------------------------------------------------
# 6. APPLICATION METADATA & BRANDING
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="MMS Studio Storage"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_STUDIO_URL="https://studio.sabbirmms.com"
